# Copy this file to wrangler.toml for local development.
# Production configuration belongs in Cloudflare Pages settings and secrets.
name = "crmakari"
compatibility_date = "2026-07-31"
pages_build_output_dir = "./public"

[vars]
AUTH_MODE = "demo"
DEFAULT_TENANT_SLUG = "akari-house"

# Keep the production D1 identifier out of local/public examples to reduce the
# chance of accidental remote commands. Add the correct binding in Cloudflare.
[[d1_databases]]
binding = "DB"
database_name = "akari-crm-production"
database_id = "REPLACE_WITH_PRODUCTION_D1_ID"
migrations_dir = "db/migrations"

# Add R2 only when permission-controlled file uploads are implemented.
# [[r2_buckets]]
# binding = "FILES"
# bucket_name = "akari-crm-files"
